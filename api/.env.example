NODE_ENV=DEV
APP_NAME=api
APP_PORT=3000
APP_BASE_URL=api
APP_CORS_ORIGIN=http://localhost:4200
APP_TRUST_PROXY=false
APP_HTTP_PAYLOAD_ERROR_CODE=422

LOG_LEVEL=debug

SWAGGER_ENABLED=true
SWAGGER_TITLE=API
SWAGGER_DESCRIPTION=HTTP API
SWAGGER_VERSION=0.1.0
SWAGGER_PATH=docs

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-local-password
DB_DATABASE=api
DB_SYNC=false
DB_MIGRATION=true
DB_LOG=false
DB_SCHEMA=public

AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_ARGON2_MEMORY_COST=19456
AUTH_PASSWORD_ARGON2_TIME_COST=2
AUTH_PASSWORD_ARGON2_PARALLELISM=1
AUTH_PASSWORD_MAX_ATTEMPTS=5
AUTH_PASSWORD_LOCKOUT_SECONDS=900

AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000

AUTH_REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
AUTH_JWT_ACTIVE_KID=primary-2026
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-es256-private-key
AUTH_JWT_PUBLIC_KEYS_JSON={"primary-2026":"replace-with-base64-spki-es256-public-key"}

AUTH_TEST_REFRESH_FAILURE_POINT=
